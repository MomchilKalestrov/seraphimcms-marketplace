{
    "compilerOptions": {
        "target": "ES2020",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@/*": [ "./src/*" ]
        },
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true
    },
    "include": [ "src" ],
    "exclude": [ "node_modules" ]
}